<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="👗 Outfit Picker"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="#862A91"
                    android:gravity="center_vertical"/>

                <TextView
                    android:id="@+id/heartIcon"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:text="♡"
                    android:textSize="45sp"
                    android:textColor="#862A91"
                    android:gravity="center"/>

            </LinearLayout>




            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome to Outfit Picker"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#862A91"
                android:gravity="center"
                android:layout_marginTop="15dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Find Your Perfect Outfit ✨"
                android:textSize="20sp"
                android:textColor="#A02090"
                android:gravity="center"
                android:layout_marginTop="8dp"/>




            <EditText
                android:id="@+id/searchOutfit"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:backgroundTint="#D98AE0"
                android:hint="Search Your Outfit..."
                android:textColor="#862A91"
                android:textSize="18sp"
                android:padding="12dp"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:inputType="text"/>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="▦  Categories"
                    android:textSize="25sp"
                    android:textStyle="bold"
                    android:textColor="#862A91"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All →"
                    android:textSize="17sp"
                    android:textColor="#862A91"/>

            </LinearLayout>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/casualWear"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:background="#EBCBF4"
                    android:gravity="center"
                    android:text="👗\nCasual\nWear"
                    android:textColor="#52145E"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/partyWear"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:background="#EBCBF4"
                    android:gravity="center"
                    android:text="💃\nParty\nWear"
                    android:textColor="#52145E"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/weddingWear"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:background="#EBCBF4"
                    android:gravity="center"
                    android:text="👰\nWedding\nWear"
                    android:textColor="#52145E"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/universityWear"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="3dp"
                    android:background="#EBCBF4"
                    android:gravity="center"
                    android:text="🎓\nUniversity\nWear"
                    android:textColor="#52145E"
                    android:textStyle="bold"
                    android:textSize="14sp"/>

            </LinearLayout>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="★  Featured Outfits"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#862A91"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All →"
                    android:textSize="17sp"
                    android:textColor="#862A91"/>

            </LinearLayout>




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/outfitImage1"
                    android:layout_width="7dp"
                    android:layout_height="match_parent"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:contentDescription="Purple outfit"
                    android:scaleType="centerCrop"
                    android:src="@drawable/outfit1" />

                <ImageView
                    android:id="@+id/outfitImage2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/outfit2"
                    android:contentDescription="Floral outfit"/>

            </LinearLayout>




            <TextView
                android:id="@+id/exploreOutfits"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:background="#8E1692"
                android:text="✨ Explore Outfits   →"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:gravity="center"/>

        </LinearLayout>

    </ScrollView>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="#FCEBFC"
        android:gravity="center">

        <TextView
            android:id="@+id/home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂\nHome"
            android:textColor="#862A91"
            android:textSize="19sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/favourite"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♡\nFavourite"
            android:textColor="#862A91"
            android:textSize="19sp"/>

        <TextView
            android:id="@+id/profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙\nProfile"
            android:textColor="#862A91"
            android:textSize="19sp"/>

    </LinearLayout>

</LinearLayout>